# ─── Conta de serviço (Self Client) ───────────────────────────────
# Lê o catálogo de custos (Recursos e Funções, Products) para todos os vendedores.
# Escopos: ZohoCRM.modules.READ,ZohoCRM.modules.custom.ALL
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# ─── Login "Entrar com Zoho" (cliente Server-based Application) ───
# Em https://api-console.zoho.com → Add Client → Server-based Applications
#   Homepage URL:            http://localhost:3000   (ou o endereço publicado)
#   Authorized Redirect URI: http://localhost:3000/api/auth/callback
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_CLIENT_SECRET=
# Endereço da calculadora (sem barra no fim) — precisa bater com o Redirect URI acima
APP_URL=http://localhost:3000
# Chave para criptografar o cookie de sessão — 32+ caracteres aleatórios
# (PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_}))
SESSION_SECRET=
# Só aceita logins desta organização do Zoho. O id aparece no log do servidor
# no primeiro login ("Defina ZOHO_ORG_ID=...").
ZOHO_ORG_ID=

# ─── Data center da conta (padrão .com) ──────────────────────────
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
